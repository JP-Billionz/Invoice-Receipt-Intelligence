# =============================================================================
# Receipt Intelligence AI — environment variables
# =============================================================================
# Copy this file to `.env.local` for local dev. On Render, set each value in the
# dashboard (NOT committed). Every variable listed here is required at runtime;
# the app fails fast at the API route boundary if any are missing.
#
# AISB Render-deploy lesson: declare all secrets in render.yaml with
# `sync: false` so the deploy refuses to start until they're set in Render.
# =============================================================================

# Postgres (Neon).
# Format: postgresql://user:password@host/dbname?sslmode=require
# Use the *pooled* connection string for the app; the unpooled one is only for
# `prisma migrate deploy`.
DATABASE_URL=

# Auth.js v5 (next-auth).
# NEXTAUTH_SECRET: any high-entropy random string (`openssl rand -base64 32`).
# NEXTAUTH_URL: full canonical URL of the deployed app, e.g.
#   https://receipt-intelligence.onrender.com  (production)
#   http://localhost:3000                      (local dev)
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# SendGrid SMTP (magic-link transport).
# SENDGRID_API_KEY must have the "Mail Send" scope.
# EMAIL_FROM must exactly match a verified sender on the SendGrid account.
SENDGRID_API_KEY=
EMAIL_FROM=AISB Receipts AI <jp@aisolutionsbb.com>

# Google Gemini — SERVER-SIDE ONLY. Never expose via NEXT_PUBLIC_*.
# Used by lib/gemini/extract.ts and lib/gemini/comparison.ts.
GEMINI_API_KEY=

# Barbados retailer allowlist for the price-comparison locality check.
# Comma-separated host suffixes; the `.bb` TLD is always implicitly trusted.
# Editable in the Render dashboard without a redeploy.
# Example: pricesmart.com,massystoresbb.com,carltonbarbados.com
BB_RETAILER_ALLOWLIST=

# Per-tenant Gemini rate limit (Plan §5.3). Optional overrides; defaults are
# baked into lib/ratelimit/tenant.ts and render.yaml.
GEMINI_RATE_LIMIT_PER_MINUTE=60
GEMINI_RATE_LIMIT_BURST=10
